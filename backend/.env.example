# Base de données
DATABASE_URL="mysql://username:password@localhost:3306/boucherie_fine"

# JWT
JWT_SECRET="votre_jwt_secret_super_securise_ici"
JWT_EXPIRES_IN="7d"

# Serveur
PORT=3000
NODE_ENV=development

# Cloudinary (pour upload d'images)
CLOUDINARY_CLOUD_NAME="votre_cloud_name"
CLOUDINARY_API_KEY="votre_api_key"
CLOUDINARY_API_SECRET="votre_api_secret"

# PayDunya (Paiement Sandbox)
PAYDUNYA_MASTER_KEY="votre_master_key_sandbox"
PAYDUNYA_PRIVATE_KEY="votre_private_key_sandbox"
PAYDUNYA_TOKEN="votre_token_sandbox"
PAYDUNYA_MODE="sandbox"

# Fusion Money (Paiement Sandbox)
FUSION_MONEY_API_KEY="votre_fusion_api_key_sandbox"
FUSION_MONEY_SECRET_KEY="votre_fusion_secret_key_sandbox"
FUSION_MONEY_MODE="sandbox"

# Email (optionnel)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="votre_email@gmail.com"
SMTP_PASS="votre_app_password"

# SMS (optionnel)
SMS_API_KEY="votre_sms_api_key"
SMS_SENDER="LaBoucherieFine"